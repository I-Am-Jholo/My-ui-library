-- LIBRARY CORE
-- ============================================================
local JholoLib = {}
JholoLib.__index = JholoLib

function JholoLib.new(config)
    config = config or {}
    local self = setmetatable({}, JholoLib)
    self.Title = config.Title or "Jholo Hub"
    self._visible = true

    -- ScreenGui
    self.ScreenGui = Util.new("ScreenGui", PlayerGui, {
        Name = "JholoLib_" .. self.Title,
        ResetOnSpawn = false,
    })

    -- Main Frame
    self.Main = Util.new("Frame", self.ScreenGui, {
        Name = "Main",
        Size = config.Size or UDim2.new(0, 500, 0, 350),
        Position = config.Position or UDim2.new(0.5, -250, 0.5, -175),
        BackgroundColor3 = Theme.BG_Main,
        BorderSizePixel = 0,
    })
    Util.new("UICorner", self.Main, {CornerRadius = Theme.Corner_Main})
    Util.new("UIStroke", self.Main, {Color = Theme.Stroke_Main, Thickness = 2})

    -- Header / Drag Handle
    self.Header = Util.new("Frame", self.Main, {
        Name = "Header",
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundTransparency = 1,
    })
    
    self.TitleLabel = Util.new("TextLabel", self.Header, {
        Text = self.Title,
        Size = UDim2.new(1, -20, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        TextColor3 = Theme.Text_Title,
        TextSize = 18,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.HorizontalAlignment.Left,
    })

    Util.makeDraggable(self.Main, self.Header)

    -- Toggle Button Logic
    self._toggleBtn = Util.new("TextButton", self.ScreenGui, {
        Name = "ToggleBtn",
        Size = UDim2.new(0, 100, 0, 30),
        Position = UDim2.new(0.5, -50, 0, 10),
        BackgroundColor3 = Theme.BG_Panel,
        Text = "Toggle UI",
        TextColor3 = Theme.Text_Primary,
        Font = Enum.Font.GothamMedium,
        TextSize = 14,
    })
    Util.new("UICorner", self._toggleBtn, {CornerRadius = Theme.Corner_Small})
    
    self._toggleBtn.MouseButton1Click:Connect(function()
        self._visible = not self._visible
        self.Main.Visible = self._visible
    end)

    return self
end

return JholoLib
