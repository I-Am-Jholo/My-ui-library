            TextColor3             = Theme.Text_Muted,
            Text                   = "▾",
            TextSize               = 14,
            Font                   = Enum.Font.GothamBold,
        })

        local listFrame = Util.new("Frame", wrapper, {
            Name             = "List",
            Size             = UDim2.new(1, 0, 0, 0),
            Position         = UDim2.new(0, 0, 1, 4),
            BackgroundColor3 = Theme.BG_Dropdown,
            BorderSizePixel  = 0,
            ClipsDescendants = true,
            ZIndex           = 5,
            Visible          = false,
        })
        Util.corner(listFrame, Theme.Corner_Elem)
        Util.stroke(listFrame, Theme.Stroke_Input, 1)

        local listLayout = Util.new("UIListLayout", listFrame, {
            Padding           = UDim.new(0, 2),
            SortOrder         = Enum.SortOrder.LayoutOrder,
            HorizontalAlignment = Enum.HorizontalAlignment.Center,
        })
        Util.padding(listFrame, 4, 4, 0, 0)

        local itemHeight = 28
        local totalHeight = #options * (itemHeight + 2) + 8

        for _, opt in ipairs(options) do
            local optBtn = Util.new("TextButton", listFrame, {
                Name             = opt .. "Opt",
                Size             = UDim2.new(0.94, 0, 0, itemHeight),
                BackgroundColor3 = Theme.BG_Element,
                TextColor3       = Theme.Text_Primary,
                Text             = opt,
                TextSize         = 12,
                Font             = Enum.Font.Gotham,
                BorderSizePixel  = 0,
                AutoButtonColor  = false,
                ZIndex           = 6,
            })
            Util.corner(optBtn, Theme.Corner_Small)

            optBtn.MouseEnter:Connect(function()
                Util.tween(optBtn, Theme.TweenInfo_Fast, { BackgroundColor3 = Theme.BG_ElementHov })
            end)
            optBtn.MouseLeave:Connect(function()
                Util.tween(optBtn, Theme.TweenInfo_Fast, { BackgroundColor3 = Theme.BG_Element })
            end)
            optBtn.MouseButton1Click:Connect(function()
                selected      = opt
                header.Text   = label .. ":  " .. selected
                open          = false
                arrow.Text    = "▾"
                listFrame.Visible = false
                Util.tween(listFrame, Theme.TweenInfo_Fast, { Size = UDim2.new(1, 0, 0, 0) })
                callback(opt)
            end)
        end

        header.MouseButton1Click:Connect(function()
            open = not open
            if open then
                listFrame.Visible = true
                arrow.Text = "▴"
                Util.tween(listFrame, Theme.TweenInfo_Medium, { Size = UDim2.new(1, 0, 0, totalHeight) })
            else
                arrow.Text = "▾"
                local t = TweenService:Create(listFrame, Theme.TweenInfo_Fast, { Size = UDim2.new(1, 0, 0, 0) })
                t:Play()
                t.Completed:Connect(function() listFrame.Visible = false end)
            end
        end)

        return wrapper
    end

