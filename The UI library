function JholoLib:addTab(name, icon)
    icon = icon or ""

    local btn = Util.new("TextButton", self.TabsScroll, {
        Name             = name .. "Tab",
        Size             = UDim2.new(0.88, 0, 0, 36),
        BackgroundColor3 = Theme.BG_Element,
        TextColor3       = Theme.Text_Muted,
        Text             = (icon ~= "" and icon .. "  " or "") .. name,
        TextSize         = 12,
        Font             = Enum.Font.GothamSemibold,
        BorderSizePixel  = 0,
        AutoButtonColor  = false,
        TextXAlignment   = Enum.TextXAlignment.Center,
    })
    Util.corner(btn, Theme.Corner_Elem)

    local page = Util.new("ScrollingFrame", self.ContentPanel, {
        Name                       = name .. "Page",
        Size                       = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency     = 1,
        BorderSizePixel            = 0,
        ScrollBarImageTransparency = 1,
        ScrollBarThickness         = 4,
        ScrollBarImageColor3       = Color3.fromRGB(60, 160, 60),
        CanvasSize                 = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize        = Enum.AutomaticSize.Y,
        Visible                    = false,
    })
    Util.listLayout(page, 8, Enum.HorizontalAlignment.Center)
    Util.padding(page, 10, 14, 0, 0)

    local tabData = { btn = btn, page = page, name = name }
    self._tabs[name] = tabData

    btn.MouseButton1Click:Connect(function() self:selectTab(name) end)

    btn.MouseEnter:Connect(function()
        if self._activeTab ~= name then
            Util.tween(btn, Theme.TweenInfo_Fast, { BackgroundColor3 = Theme.BG_ElementHov })
        end
    end)
    btn.MouseLeave:Connect(function()
        if self._activeTab ~= name then
            Util.tween(btn, Theme.TweenInfo_Fast, { BackgroundColor3 = Theme.BG_Element })
        end
    end)

    if not self._activeTab then
        self:selectTab(name)
    end

    -- Tab object (chaining API)
    local Tab    = {}
    Tab._page    = page
    Tab._lib     = self

    function Tab:addButton(label, callback)                        return self._lib:addButton(self._page, label, callback) end
    function Tab:addToggle(label, default, callback)               return self._lib:addToggle(self._page, label, default, callback) end
    function Tab:addSlider(label, min, max, default, callback)     return self._lib:addSlider(self._page, label, min, max, default, callback) end
    function Tab:addDropdown(label, options, callback)             return self._lib:addDropdown(self._page, label, options, callback) end
    function Tab:addInput(label, placeholder, callback)            return self._lib:addInput(self._page, label, placeholder, callback) end
    function Tab:addLabel(text)               
