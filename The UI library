function JholoLib:addButton(page, label, callback)
    local btn = Util.new("TextButton", page, {
        Size             = UDim2.new(0.93, 0, 0, 34),
        BackgroundColor3 = Theme.BG_Element,
        TextColor3       = Theme.Text_Primary,
        Text             = label,
        TextSize         = 13,
        Font             = Enum.Font.GothamSemibold,
        BorderSizePixel  = 0,
        AutoButtonColor  = false,
    })
    Util.corner(btn, Theme.Corner_Elem)
    Util.stroke(btn, Theme.Stroke_Elem, 1)

    btn.MouseEnter:Connect(function()
        Util.tween(btn, Theme.TweenInfo_Fast, { BackgroundColor3 = Theme.BG_ElementHov })
    end)
    btn.MouseLeave:Connect(function()
        Util.tween(btn, Theme.TweenInfo_Fast, { BackgroundColor3 = Theme.BG_Element })
    end)
    btn.MouseButton1Click:Connect(function()
        Util.tween(btn, Theme.TweenInfo_Fast, { BackgroundColor3 = Theme.BG_Active })
        task.delay(0.15, function()
            Util.tween(btn, Theme.TweenInfo_Fast, { BackgroundColor3 = Theme.BG_Element })
        end)
        if callback then callback() end
    end)

    return btn
end

-- ============================================================
-- TOGGLE
-- ============================================================
function JholoLib:addToggle(page, label, default, callback)
    local state = default or false

    local row = Util.new("Frame", page, {
        Size             = UDim2.new(0.93, 0, 0, 34),
        BackgroundColor3 = Theme.BG_Element,
        BorderSizePixel  = 0,
    })
    Util.corner(row, Theme.Corner_Elem)
    Util.stroke(row, Theme.Stroke_Elem, 1)

    Util.new("TextLabel", row, {
        Size                   = UDim2.new(1, -56, 1, 0),
        Position               = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        TextColor3             = Theme.Text_Label,
        Text                   = label,
        TextSize               = 13,
        Font                   = Enum.Font.Gotham,
        TextXAlignment         = Enum.TextXAlignment.Left,
    })

    local track = Util.new("Frame", row, {
        Size             = UDim2.new(0, 40, 0, 20),
        Position         = UDim2.new(1, -48, 0.5, -10),
        BackgroundColor3 = state and Theme.BG_Toggle_On or Theme.BG_Toggle_Off,
        BorderSizePixel  = 0,
    })
    Util.corner(track, UDim.new(1, 0))

    local knob = Util.new("Frame", track, {
        Size             = UDim2.new(0, 14, 0, 14),
        Position         = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel  = 0,
    })
    Util.corner(knob, UDim.new(1, 0))

    local function updateVisual()
        Util.tween(track, Theme.TweenInfo_Fast, {
            BackgroundColor3 = state and Theme.BG_Toggle_On or Theme.BG_Toggle_Off,
        })
        Util.tween(knob, Theme.TweenInfo_Fast, {
            Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
        })
    end

    local btn = Util.new("TextButton", row, {
        Size                   = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text                   = "",
        BorderSizePixel        = 0,
    })
    btn.MouseButton1Click:Connect(function()
        state = not state
        updateVisual()
        if callback then callback(state) end
    end)

    -- Return control object
    local ctrl = {}
    function ctrl:set(val)
        state = val
        updateVisual()
        if callback then callback(state) end
    end
    function ctrl:get() return state end
    return ctrl
end

