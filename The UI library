        TextXAlignment         = Enum.TextXAlignment.Left,
    })
    Util.new("TextLabel", notif, {
        Size                   = UDim2.new(1, -12, 0, 26),
        Position               = UDim2.new(0, 8, 0, 26),
        BackgroundTransparency = 1,
        TextColor3             = Theme.Text_Muted,
        Text                   = message,
        TextSize               = 11,
        Font                   = Enum.Font.Gotham,
        TextXAlignment         = Enum.TextXAlignment.Left,
        TextWrapped            = true,
    })

    -- Progress bar
    local bar = Util.new("Frame", notif, {
        Size             = UDim2.new(1, 0, 0, 3),
        Position         = UDim2.new(0, 0, 1, -3),
        BackgroundColor3 = Theme.BG_SliderFill,
        BorderSizePixel  = 0,
    })
    Util.corner(bar, UDim.new(0, 2))

    -- Fade in
    Util.tween(notif, Theme.TweenInfo_Medium, { BackgroundTransparency = 0 })
    Util.tween(bar, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 3) })

    task.delay(duration, function()
        Util.tween(notif, Theme.TweenInfo_Medium, { BackgroundTransparency = 1 })
        task.delay(0.3, function()
            notif:Destroy()
        end)
    end)
end

