-- ============================================================
-- NOTIFICATION
-- ============================================================
function JholoLib:notify(title, message, duration)
    duration = duration or 4

    local notif = Util.new("Frame", self._notifContainer, {
        Size             = UDim2.new(1, 0, 0, 60),
        BackgroundColor3 = Theme.BG_Panel,
        BorderSizePixel  = 0,
        BackgroundTransparency = 1,
    })
    Util.corner(notif, UDim.new(0, 8))
    Util.stroke(notif, Theme.Stroke_Elem, 1.5)

    Util.new("TextLabel", notif, {
        Size                   = UDim2.new(1, -12, 0, 22),
        Position               = UDim2.new(0, 8, 0, 4),
        BackgroundTransparency = 1,
        TextColor3             = Theme.Text_Title,
        Text                   = title,
        TextSize               = 13,
        Font                   = Enum.Font.GothamBold,
        TextXAlignment         = Enum.TextXAlignment.Left,
    })
    Util.new("TextLabel", notif, {
        Size                   = UDim2.new(1, -12, 0, 26),
        Position               = UDim2.new(0, 8, 0, 26),
        BackgroundTransparency = 1,
        TextColor3             = Theme.Text_Muted,
        Text                   = message,
        TextSize               = 11,
        Font                   = Enum.Font.Gotham,
        TextXAlignment         = Enum.TextXAlignment.Left,
        TextWrapped            = true,
    })

    -- Progress bar
    local bar = Util.new("Frame", notif, {
        Size             = UDim2.new(1, 0, 0, 3),
        Position         = UDim2.new(0, 0, 1, -3),
        BackgroundColor3 = Theme.BG_SliderFill,
        BorderSizePixel  = 0,
    })
    Util.corner(bar, UDim.new(0, 2))

    -- Fade in
    Util.tween(notif, Theme.TweenInfo_Medium, { BackgroundTransparency = 0 })
    Util.tween(bar, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 3) })

    task.delay(duration, function()
        Util.tween(notif, Theme.TweenInfo_Medium, { BackgroundTransparency = 1 })
        task.delay(0.3, function()
            notif:Destroy()
        end)
    end)
end

