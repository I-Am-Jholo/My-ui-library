-- ============================================================
-- NOTIFICATION
-- ============================================================
function JholoLib:notify(title, message, duration)
    duration = duration or 4

    local notif = Util.new("Frame", self._notifContainer, {
        Name             = "Notif",
        Size             = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = Theme.BG_Panel,
        BorderSizePixel  = 0,
        ClipsDescendants = true,
        ZIndex           = 20,
    })
    Util.corner(notif, Theme.Corner_Elem)
    Util.stroke(notif, Theme.Stroke_Main, 1.5)
    Util.padding(notif, 8, 8, 10, 10)

    local layout = Util.new("UIListLayout", notif, {
        Padding   = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    Util.new("TextLabel", notif, {
        Name                   = "Title",
        Size                   = UDim2.new(1, 0, 0, 16),
        BackgroundTransparency = 1,
        TextColor3             = Theme.Text_Title,
        Text                   = title,
        TextSize               = 13,
        Font                   = Enum.Font.GothamBold,
        TextXAlignment         = Enum.TextXAlignment.Left,
        ZIndex                 = 21,
    })

    Util.new("TextLabel", notif, {
        Name                   = "Message",
        Size                   = UDim2.new(1, 0, 0, 14),
        BackgroundTransparency = 1,
        TextColor3             = Theme.Text_Primary,
        Text                   = message,
        TextSize               = 11,
        Font                   = Enum.Font.Gotham,
        TextXAlignment         = Enum.TextXAlignment.Left,
        TextWrapped            = true,
        ZIndex                 = 21,
    })

    -- Progress bar
    local bar = Util.new("Frame", notif, {
        Name             = "Bar",
        Size             = UDim2.new(1, 0, 0, 3),
        BackgroundColor3 = Theme.BG_SliderFill,
        BorderSizePixel  = 0,
        ZIndex           = 21,
    })
    Util.corner(bar, UDim.new(1, 0))

    -- Slide in
    Util.tween(notif, Theme.TweenInfo_Medium, { Size = UDim2.new(1, 0, 0, 58) })

    -- Progress bar drain
    task.delay(0.3, function()
        Util.tween(bar, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 3) })
    end)

    -- Slide out and destroy
    task.delay(duration + 0.3, function()
        local t = TweenService:Create(notif, Theme.TweenInfo_Medium, { Size = UDim2.new(1, 0, 0, 0) })
        t:Play()
        t.Completed:Connect(function()
            notif:Destroy()
        end)
    end)
end

