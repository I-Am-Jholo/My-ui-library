-- ============================================================
-- UTILITY
-- ============================================================
local Util = {}

function Util.tween(obj, info, props)
    TweenService:Create(obj, info, props):Play()
end

function Util.new(class, parent, props)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    if parent then inst.Parent = parent end
    return inst
end

function Util.corner(parent, radius)
    return Util.new("UICorner", parent, { CornerRadius = radius or Theme.Corner_Elem })
end

function Util.stroke(parent, color, thickness)
    return Util.new("UIStroke", parent, {
        Color     = color or Theme.Stroke_Elem,
        Thickness = thickness or 1.5,
    })
end

function Util.padding(parent, top, bottom, left, right)
    return Util.new("UIPadding", parent, {
        PaddingTop    = UDim.new(0, top    or 0),
        PaddingBottom = UDim.new(0, bottom or 0),
        PaddingLeft   = UDim.new(0, left   or 0),
        PaddingRight  = UDim.new(0, right  or 0),
    })
end

function Util.listLayout(parent, padding, halign, valign)
    return Util.new("UIListLayout", parent, {
        Padding             = UDim.new(0, padding or 6),
        HorizontalAlignment = halign or Enum.HorizontalAlignment.Center,
        VerticalAlignment   = valign or Enum.VerticalAlignment.Top,
        SortOrder           = Enum.SortOrder.LayoutOrder,
    })
end

-- Fade every renderable descendant to a given transparency
local function fadeDescendants(frame, targetT, tweenInfo)
    for _, obj in ipairs(frame:GetDescendants()) do
        if obj:IsA("Frame") or obj:IsA("ScrollingFrame") then
            TweenService:Create(obj, tweenInfo, { BackgroundTransparency = targetT }):Play()
        elseif obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            TweenService:Create(obj, tweenInfo, { TextTransparency = targetT, BackgroundTransparency = targetT }):Play()
        elseif obj:IsA("UIStroke") then
            TweenService:Create(obj, tweenInfo, { Transparency = targetT }):Play()
        end
    end
end

-- Reset all transparencies instantly (used after close completes)
local function resetTransparencies(frame)
    for _, obj in ipairs(frame:GetDescendants()) do
        if obj:IsA("Frame") or obj:IsA("ScrollingFrame") then
            obj.BackgroundTransparency = 0
        elseif obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            obj.TextTransparency       = 0
            obj.BackgroundTransparency = 0
        elseif obj:IsA("UIStroke") then
            obj.Transparency = 0
        end
    end
end

function Util.makeDraggable(frame, handle)
    handle = handle or frame
    local dragging, dragInput, mousePos, framePos = false, nil, nil, nil

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            mousePos = input.Position
            framePos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - mousePos
            frame.Position = UDim2.new(
                framePos.X.Scale, framePos.X.Offset + delta.X,
                framePos.Y.Scale, framePos.Y.Offset + delta.Y
            )
        end
    end)
end

