-- ============================================================
-- OPEN / CLOSE / TOGGLE
-- ============================================================
function JholoLib:open()
    if self._animating then return end
    self._animating = true
    self._visible   = true

    resetTransparencies(self.MainFrame)
    self.MainFrame.Visible   = true
    self.MainFrame.Size      = UDim2.new(0, 10, 0, 10)
    self.MainFrame.Position  = UDim2.new(0.5, -5, 0.5, -5)

    local tween = TweenService:Create(self.MainFrame, Theme.TweenInfo_Open, {
        Size     = self._openSize,
        Position = self._openPos,
    })
    tween:Play()
    tween.Completed:Connect(function()
        self._animating = false
    end)
end

function JholoLib:close()
    if self._animating then return end
    self._animating = true
    self._visible   = false

    snapshotTransparencies(self.MainFrame)

    local bgTween = TweenService:Create(self.MainFrame, Theme.TweenInfo_Close, {
        BackgroundTransparency = 1,
    })
    fadeDescendants(self.MainFrame, 1, Theme.TweenInfo_Close)
    bgTween:Play()
    bgTween.Completed:Connect(function()
        self.MainFrame.Visible = false
        self._animating = false
    end)
end

function JholoLib:toggle()
    if self._visible then self:close() else self:open() end
end

function JholoLib:setVisible(state)
    if state then self:open() else self:close() end
end

-- ============================================================
-- SELECT TAB
-- ============================================================
function JholoLib:selectTab(name)
    for tabName, data in pairs(self._tabs) do
        local active = (tabName == name)
        data.page.Visible = active
        Util.tween(data.btn, Theme.TweenInfo_Fast, {
            BackgroundColor3 = active and Theme.BG_Active  or Theme.BG_Element,
            TextColor3       = active and Theme.Text_Active or Theme.Text_Muted,
        })
    end
    self._activeTab = name
end

