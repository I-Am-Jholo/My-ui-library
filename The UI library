        Position               = UDim2.new(1, -24, 0, 0),
        BackgroundTransparency = 1,
        TextColor3             = Theme.Text_Muted,
        Text                   = "▾",
        TextSize               = 14,
        Font                   = Enum.Font.GothamBold,
    })

    local listFrame = Util.new("Frame", wrapper, {
        Size             = UDim2.new(1, 0, 0, 0),
        Position         = UDim2.new(0, 0, 0, 36),
        BackgroundColor3 = Theme.BG_Dropdown,
        BorderSizePixel  = 0,
        ClipsDescendants = true,
        ZIndex           = 5,
        Visible          = false,
    })
    Util.corner(listFrame, Theme.Corner_Elem)
    Util.stroke(listFrame, Theme.Stroke_Elem, 1)

    local listLayout = Util.listLayout(listFrame, 2, Enum.HorizontalAlignment.Center)
    Util.padding(listFrame, 4, 4, 0, 0)

    local optionBtns = {}
    for _, opt in ipairs(options) do
        local ob = Util.new("TextButton", listFrame, {
            Size             = UDim2.new(0.94, 0, 0, 28),
            BackgroundColor3 = Theme.BG_Element,
            TextColor3       = Theme.Text_Primary,
            Text             = opt,
            TextSize         = 12,
            Font             = Enum.Font.Gotham,
            BorderSizePixel  = 0,
            AutoButtonColor  = false,
            ZIndex           = 6,
        })
        Util.corner(ob, Theme.Corner_Small)
        ob.MouseEnter:Connect(function()
            Util.tween(ob, Theme.TweenInfo_Fast, { BackgroundColor3 = Theme.BG_ElementHov })
        end)
        ob.MouseLeave:Connect(function()
            Util.tween(ob, Theme.TweenInfo_Fast, { BackgroundColor3 = Theme.BG_Element })
        end)
        ob.MouseButton1Click:Connect(function()
            selected    = opt
            header.Text = label .. ": " .. selected
            open = false
            Util.tween(listFrame, Theme.TweenInfo_Fast, { Size = UDim2.new(1, 0, 0, 0) })
            task.delay(0.15, function() listFrame.Visible = false end)
            arrow.Text = "▾"
            if callback then callback(selected) end
        end)
        table.insert(optionBtns, ob)
    end

    local listHeight = #options * 30 + 8

    header.MouseButton1Click:Connect(function()
        open = not open
        if open then
            listFrame.Visible = true
            listFrame.Size    = UDim2.new(1, 0, 0, 0)
            Util.tween(listFrame, Theme.TweenInfo_Medium, { Size = UDim2.new(1, 0, 0, listHeight) })
            arrow.Text = "▴"
            wrapper.Size = UDim2.new(0.93, 0, 0, 34 + listHeight + 4)
        else
            Util.tween(listFrame, Theme.TweenInfo_Fast, { Size = UDim2.new(1, 0, 0, 0) })
            task.delay(0.15, function() listFrame.Visible = false end)
            arrow.Text   = "▾"
            wrapper.Size = UDim2.new(0.93, 0, 0, 34)
        end
    end)

    local ctrl = {}
    function ctrl:set(val)
        selected    = val
        header.Text = label .. ": " .. selected
        if callback then callback(selected) end
    end
    function ctrl:get() return selected end
    return ctrl
end

