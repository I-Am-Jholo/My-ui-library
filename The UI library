            Position               = UDim2.new(0.7, 0, 0, 0),
            BackgroundTransparency = 1,
            TextColor3             = Theme.Text_Active,
            Text                   = tostring(value),
            TextSize               = 12,
            Font                   = Enum.Font.GothamBold,
            TextXAlignment         = Enum.TextXAlignment.Right,
        })

        local track = Util.new("Frame", container, {
            Name             = "Track",
            Size             = UDim2.new(1, 0, 0, 8),
            Position         = UDim2.new(0, 0, 1, -14),
            BackgroundColor3 = Theme.BG_Slider,
            BorderSizePixel  = 0,
        })
        Util.corner(track, UDim.new(1, 0))

        local fill = Util.new("Frame", track, {
            Name             = "Fill",
            Size             = UDim2.new((value - min) / (max - min), 0, 1, 0),
            BackgroundColor3 = Theme.BG_SliderFill,
            BorderSizePixel  = 0,
        })
        Util.corner(fill, UDim.new(1, 0))

        local function setSlider(v)
            value = math.clamp(math.round(v), min, max)
            local pct = (value - min) / (max - min)
            Util.tween(fill, Theme.TweenInfo_Fast, { Size = UDim2.new(pct, 0, 1, 0) })
            valLabel.Text = tostring(value)
            callback(value)
        end

        local dragging = false
        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
            end
        end)
        track.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
                local trackPos  = track.AbsolutePosition.X
                local trackSize = track.AbsoluteSize.X
                local rel = math.clamp((input.Position.X - trackPos) / trackSize, 0, 1)
                setSlider(min + rel * (max - min))
            end
        end)
        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                local trackPos  = track.AbsolutePosition.X
                local trackSize = track.AbsoluteSize.X
                local rel = math.clamp((input.Position.X - trackPos) / trackSize, 0, 1)
                setSlider(min + rel * (max - min))
            end
        end)

        return container
    end

