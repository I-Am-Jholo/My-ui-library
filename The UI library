    local knob = Util.new("Frame", track, {
        Size             = UDim2.new(0, 14, 0, 14),
        Position         = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel  = 0,
    })
    Util.corner(knob, UDim.new(1, 0))

    local function updateVisual()
        Util.tween(track, Theme.TweenInfo_Fast, {
            BackgroundColor3 = state and Theme.BG_Toggle_On or Theme.BG_Toggle_Off,
        })
        Util.tween(knob, Theme.TweenInfo_Fast, {
            Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
        })
    end

    local btn = Util.new("TextButton", row, {
        Size                   = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text                   = "",
        BorderSizePixel        = 0,
    })
    btn.MouseButton1Click:Connect(function()
        state = not state
        updateVisual()
        if callback then callback(state) end
    end)

    -- Return control object
    local ctrl = {}
    function ctrl:set(val)
        state = val
        updateVisual()
        if callback then callback(state) end
    end
    function ctrl:get() return state end
    return ctrl
end

-- ============================================================
-- SLIDER
-- ============================================================
function JholoLib:addSlider(page, label, min, max, default, callback)
    min     = min     or 0
    max     = max     or 100
    default = default or min
    local value = math.clamp(default, min, max)

    local row = Util.new("Frame", page, {
        Size             = UDim2.new(0.93, 0, 0, 50),
        BackgroundColor3 = Theme.BG_Element,
        BorderSizePixel  = 0,
    })
    Util.corner(row, Theme.Corner_Elem)
    Util.stroke(row, Theme.Stroke_Elem, 1)

    local lbl = Util.new("TextLabel", row, {
        Size                   = UDim2.new(1, -10, 0, 20),
        Position               = UDim2.new(0, 10, 0, 6),
        BackgroundTransparency = 1,
        TextColor3             = Theme.Text_Label,
        Text                   = label .. ": " .. tostring(math.round(value)),
        TextSize               = 12,
        Font                   = Enum.Font.Gotham,
        TextXAlignment         = Enum.TextXAlignment.Left,
    })

    local track = Util.new("Frame", row, {
        Size             = UDim2.new(1, -20, 0, 8),
        Position         = UDim2.new(0, 10, 0, 32),
        BackgroundColor3 = Theme.BG_Slider,
        BorderSizePixel  = 0,
    })
    Util.corner(track, UDim.new(1, 0))

    local fill = Util.new("Frame", track, {
        Size             = UDim2.new((value - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = Theme.BG_SliderFill,
        BorderSizePixel  = 0,
    })
    Util.corner(fill, UDim.new(1, 0))

    local function updateSlider(input)
        local trackPos  = track.AbsolutePosition.X
        local trackSize = track.AbsoluteSize.X
        local rel       = math.clamp((input.Position.X - trackPos) / trackSize, 0, 1)
        value = math.round(min + (max - min) * rel)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        lbl.Text  = label .. ": " .. tostring(value)
        if callback then callback(value) end
    end

    local dragging = false
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateSlider(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            updateSlider(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    local ctrl = {}
    function ctrl:set(val)
        value     = math.clamp(val, min, max)
        local rel = (value - min) / (max - min)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        lbl.Text  = label .. ": " .. tostring(math.round(value))
        if callback then callback(value) end
    end
    function ctrl:get() return value end
    return ctrl
end

-- ============================================================
-- DROPDOWN
-- ============================================================
function JholoLib:addDropdown(page, label, options, callback)
    options = options or {}
    local selected = options[1] or "None"
    local open     = false

    local wrapper = Util.new("Frame", page, {
        Size             = UDim2.new(0.93, 0, 0, 34),
        BackgroundTransparency = 1,
        BorderSizePixel  = 0,
        ClipsDescendants = false,
    })

    local header = Util.new("TextButton", wrapper, {
        Size             = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = Theme.BG_Element,
        TextColor3       = Theme.Text_Primary,
        Text             = label .. ": " .. selected,
        TextSize         = 12,
        Font             = Enum.Font.Gotham,
        BorderSizePixel  = 0,
        AutoButtonColor  = false,
        TextXAlignment   = Enum.TextXAlignment.Left,
    })
    Util.corner(header, Theme.Corner_Elem)
    Util.stroke(header, Theme.Stroke_Elem, 1)
    Util.padding(header, 0, 0, 10, 0)

    -- Arrow indicator
    local arrow = Util.new("TextLabel", header, {
        Size                   = UDim2.new(0, 20, 1, 0),
        Position               = UDim2.new(1, -24, 0, 0),
        BackgroundTransparency = 1,
        TextColor3             = Theme.Text_Muted,
        Text                   = "▾",
        TextSize               = 14,
        Font                   = Enum.Font.GothamBold,
    })

    local listFrame = Util.new("Frame", wrapper, {
        Size             = UDim2.new(1, 0, 0, 0),
        Position         = UDim2.new(0, 0, 0, 36),
        BackgroundColor3 = Theme.BG_Dropdown,
        BorderSizePixel  = 0,
        ClipsDescendants = true,
        ZIndex           = 5,
        Visible          = false,
    })
    Util.corner(listFrame, Theme.Corner_Elem)
    Util.stroke(listFrame, Theme.Stroke_Elem, 1)

    local listLayout = Util.listLayout(listFrame, 2, Enum.HorizontalAlignment.Center)
    Util.padding(listFrame, 4, 4, 0, 0)

    local optionBtns = {}
    for _, opt in ipairs(options) do
        local ob = Util.new("TextButton", listFrame, {
            Size             = UDim2.new(0.94, 0, 0, 28),
            BackgroundColor3 = Theme.BG_Element,
            TextColor3       = Theme.Text_Primary,
            Text             = opt,
            TextSize         = 12,
            Font             = Enum.Font.Gotham,
            BorderSizePixel  = 0,
            AutoButtonColor  = false,
            ZIndex           = 6,
        })
        Util.corner(ob, Theme.Corner_Small)
        ob.MouseEnter:Connect(function()
            Util.tween(ob, Theme.TweenInfo_Fast, { BackgroundColor3 = Theme.BG_ElementHov })
        end)
        ob.MouseLeave:Connect(function()
            Util.tween(ob, Theme.TweenInfo_Fast, { BackgroundColor3 = Theme.BG_Element })
        end)
        ob.MouseButton1Click:Connect(function()
            selected    = opt
            header.Text = label .. ": " .. selected
            open = false
            Util.tween(listFrame, Theme.TweenInfo_Fast, { Size = UDim2.new(1, 0, 0, 0) })
            task.delay(0.15, function() listFrame.Visible = false end)
            arrow.Text = "▾"
            if callback then callback(selected) end
        end)
        table.insert(optionBtns, ob)
    end

    local listHeight = #options * 30 + 8

    header.MouseButton1Click:Connect(function()
        open = not open
        if open then
            listFrame.Visible = true
            listFrame.Size    = UDim2.new(1, 0, 0, 0)
            Util.tween(listFrame, Theme.TweenInfo_Medium, { Size = UDim2.new(1, 0, 0, listHeight) })
            arrow.Text = "▴"
            wrapper.Size = UDim2.new(0.93, 0, 0, 34 + listHeight + 4)
        else
            Util.tween(listFrame, Theme.TweenInfo_Fast, { Size = UDim2.new(1, 0, 0, 0) })
            task.delay(0.15, function() listFrame.Visible = false end)
            arrow.Text   = "▾"
            wrapper.Size = UDim2.new(0.93, 0, 0, 34)
        end
    end)

    local ctrl = {}
    function ctrl:set(val)
        selected    = val
        header.Text = label .. ": " .. selected
        if callback then callback(selected) end
    end
    function ctrl:get() return selected end
    return ctrl
end

